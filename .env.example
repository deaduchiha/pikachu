# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Public URL for Telegram webhook (no trailing slash)
WEBHOOK_HOST=https://your-domain.example
WEBHOOK_PATH=/webhook

# WPPConnect (WhatsApp HTTP API) — same secret on wppconnect + bot services
# Generate one: openssl rand -hex 16
WPPCONNECT_URL=http://wppconnect:21465
WPPCONNECT_SESSION=default
WPPCONNECT_SECRET_KEY=replace_with_openssl_rand_hex_16
# Channel JID after following LAMensa (e.g. 120363171744447809@newsletter).
# Leave empty to auto-detect when exactly one channel is subscribed.
WHATSAPP_CHANNEL_ID=
WHATSAPP_CHANNEL_INVITE=0029Vb5cElw5a23zVecmn70P

# Optional ARDiS fallback when WPPConnect fails (default: false)
ARDIS_FALLBACK=false
ARDIS_MENU_URL=https://www.ardis.fvg.it/contenuti.php?id=214&view=page

# Optional translation (leave TRANSLATE_URL empty to skip)
TRANSLATE_URL=
TRANSLATE_API_KEY=

# Cache tuning
CACHE_TTL_SECONDS=1800
REFRESH_INTERVAL_SECONDS=900
